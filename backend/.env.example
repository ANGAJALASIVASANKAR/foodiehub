# Database
DB_URL=jdbc:mysql://localhost:3306/foodiehub?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=

# Security
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# CORS (comma-separated origins for the Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Razorpay (leave empty to disable online payments / COD only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Delivery pricing
DELIVERY_CHARGE=40
FREE_DELIVERY_THRESHOLD=499
TAX_RATE_PERCENT=5

# Mail (optional; forgot-password falls back to log token in dev)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
